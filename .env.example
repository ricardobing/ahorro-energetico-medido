# Copia este archivo a .env (no se sube al repositorio).

# --- API ---
PORT=4100
# Habilita «Ver como», el reloj fijo y el panel de demostración. Como «Ver como» entra sin
# autenticación, la API arranca con DEMO_MODE=true solo si NODE_ENV es development o test.
# `npm run dev` lee este archivo; `npm start` no, así que un despliegue no hereda estos valores.
NODE_ENV=development
DEMO_MODE=true
# Sin definir: MongoDB embebido (mongodb-memory-server en modo réplica, persistente en ./.data).
# MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0

# --- Servicios existentes de Kamai, simulados (apps/mocks, puerto 4110) ---
MESSAGING_SERVICE_URL=http://localhost:4110/messaging
MESSAGING_API_KEY=solo-desarrollo
SUBTASKS_SERVICE_URL=http://localhost:4110/subtasks
CURRENCY_SERVICE_URL=http://localhost:4110/currency

# --- IA: perfil asistido (SDK oficial de OpenAI) ---
# Solo desarrollo, por costos: OpenRouter + DeepSeek V4.1 Flash, con datos ficticios.
# Sin clave, la app funciona igual: sugiere por palabras clave.
AI_PROFILE_ASSIST_ENABLED=false
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL_TEXT=deepseek/deepseek-v4.1-flash

# Referencia de producción (un modelo de OpenAI elegido con el eval y la DPIA; verificar el ID exacto):
# AI_BASE_URL=
# AI_MODEL_TEXT=<modelo de OpenAI>
